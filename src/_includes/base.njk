<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script src="assets/head.js"></script>
<title>{{ pageTitle if pageTitle else (title + " | " + site.name) }}</title>
<meta name="description" content="{{ description if description else site.description }}" />
<link rel="canonical" href="{{ site.domain }}{{ canonical if canonical else '/' }}" />
<meta name="theme-color" content="{{ site.themeColor }}" />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:title" content="{{ ogTitle if ogTitle else title }}" />
<meta property="og:description" content="{{ description if description else site.description }}" />
<meta property="og:url" content="{{ site.domain }}{{ canonical if canonical else '/' }}" />
<meta property="og:image" content="{{ site.domain }}/assets/og.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ ogTitle if ogTitle else title }}" />
<meta name="twitter:description" content="{{ description if description else site.description }}" />
<meta name="twitter:image" content="{{ site.domain }}/assets/og.png" />
<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="assets/icon-192.png" />
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png" />
<link rel="manifest" href="site.webmanifest" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="assets/styles.css" />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "name": "{{ site.name }}",
  "description": "{{ site.description }}",
  "url": "{{ site.domain }}/",
  "image": "{{ site.domain }}/assets/og.png",
  "logo": "{{ site.domain }}/assets/icon-512.png",
  "areaServed": "{{ site.region }}",
  "telephone": "{{ site.phone }}",
  "email": "{{ site.email }}",
  "address": { "@type": "PostalAddress", "addressLocality": "Saratoga Springs", "addressRegion": "NY", "addressCountry": "US" }
}
</script>
{% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body>
<a class="skip-link" href="#about">Skip to main content</a>
{% if site.previewMode %}<div class="ribbon">Preview</div>{% endif %}

<nav>
  <div class="wrap nav-in">
    <a href="index.html" class="brand">
      <span class="brand-logo-plate"><img class="brand-logo" src="assets/logo-nav.png" width="1120" height="491" alt="{{ site.name }}, {{ site.tagline }}" /></span>
    </a>
    <div class="nav-links" id="menu">
      <a href="#about">Who We Are</a>
      <a href="#portfolio">Portfolio</a>
      <a href="#projects">Track Record</a>
      <a href="#upcoming">In the Pipeline</a>
      <a href="#press">In the News</a>
      <a href="#contact">Contact</a>
      <a href="#contact" class="btn js-inquire">Inquire</a>
    </div>
    <button class="burger" id="burger" aria-label="Menu" aria-controls="menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</nav>

{{ content | safe }}

<footer id="contact">
  <div class="wrap">
    <div class="foot">
      <div>
        <span class="foot-logo"><img src="assets/logo-nav.png" width="1120" height="491" alt="Cole's Capital Group, Real Estate Holdings and Development" /></span>
        <p>A privately held real estate investment and management company based in {{ site.locality }}.</p>
      </div>
      <div>
        <h5>Contact</h5>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
        {% if site.social.instagram %}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
        {% if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
      </div>
      <div>
        <h5>Company</h5>
        <a href="#about">Who We Are</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#projects">Track Record</a>
      </div>
    </div>
    <div class="copyr">
      <span>© 2026 {{ site.name }}. All rights reserved.</span>
      <span>Design by Teflon Don LLC</span>
    </div>
  </div>
</footer>

<div class="modal-overlay" id="inquireModal" aria-hidden="true">
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="inquireTitle">
    <button type="button" class="modal-close" id="modalClose" aria-label="Close">&times;</button>
    <h3 id="inquireTitle">Get in Touch</h3>
    <p class="modal-sub">Send us a message and we'll get back to you shortly.</p>
    <form id="inquireForm" data-mailto="{{ site.email }}" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="{{ site.web3formsKey }}" />
      <input type="hidden" name="subject" value="New inquiry from {{ site.domain }}" />
      <input type="hidden" name="from_name" value="{{ site.name }} website" />
      <div class="form-row">
        <label for="inq-name">Name</label>
        <input type="text" id="inq-name" name="name" required />
      </div>
      <div class="form-row">
        <label for="inq-email">Email</label>
        <input type="email" id="inq-email" name="email" required />
      </div>
      <div class="form-row">
        <label for="inq-message">Message</label>
        <textarea id="inq-message" name="message" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn-fill">Send Message</button>
      <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
    </form>
  </div>
</div>

<div class="modal-overlay lightbox-overlay" id="galleryModal" aria-hidden="true">
  <div class="lightbox-panel" role="dialog" aria-modal="true" aria-label="Photo gallery">
    <button type="button" class="modal-close" id="galleryClose" aria-label="Close">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="galleryPrev" aria-label="Previous photo">&larr;</button>
    <img class="lightbox-img" id="galleryImg" src="" alt="" />
    <button type="button" class="lightbox-nav lightbox-next" id="galleryNext" aria-label="Next photo">&rarr;</button>
    <p class="lightbox-count" id="galleryCount"></p>
  </div>
</div>

<script type="module" src="assets/app.js"></script>
{% if site.analyticsToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.analyticsToken }}"}'></script>{% endif %}
</body>
</html>
